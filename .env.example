# Copy this file to ".env" and fill in your token.
#   Windows:  copy .env.example .env
#
# The .env file is git-ignored, so your token never gets committed.
# It is ONLY needed for the hosted Hugging Face Inference API backend;
# running the model locally (the default) needs no token.
#
# Create a free "Read" token at https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
